# AI Marketing Autopilot - Environment Variables

# ========================================
# DATABASE (REQUIRED)
# ========================================
# PostgreSQL connection string
# Option 1: Neon.tech (recommended) - https://neon.tech
# Option 2: Supabase - https://supabase.com
# Option 3: Local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketing_autopilot?schema=public"

# ========================================
# REDIS (REQUIRED for job scheduling)
# ========================================
# Option 1: Full connection URL (Upstash format)
REDIS_URL="redis://localhost:6379"

# Option 2: Separate connection details (alternative)
# REDIS_HOST="localhost"
# REDIS_PORT="6379"
# REDIS_PASSWORD=""

# ========================================
# AUTHENTICATION
# ========================================
# JWT secret for API authentication (change in production!)
JWT_SECRET="your-jwt-secret-change-in-production-abc123xyz789"

# NextAuth configuration (future OAuth support)
NEXTAUTH_SECRET="your-nextauth-secret-change-in-production-def456uvw"
NEXTAUTH_URL="http://localhost:3000"

# ========================================
# OPENAI API (REQUIRED)
# ========================================
# Get your API key at: https://platform.openai.com/api-keys
# Note: Requires billing enabled ($5+ credit)
OPENAI_API_KEY="sk-proj-demo-key-please-replace-with-real-key"

# ========================================
# ENCRYPTION
# ========================================
# AES-256 encryption key for storing platform API credentials
# Generate new key: openssl rand -base64 32
ENCRYPTION_KEY="ubLudRiygneCDIWptRVFz7ltR5cPAuo5PS+DBeDp0ww="

# ========================================
# API CONFIGURATION
# ========================================
# Backend API URL for frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Backend server port
API_PORT=4000

# CORS allowed origin
CORS_ORIGIN="http://localhost:3000"

# ========================================
# FILE UPLOADS (Optional)
# ========================================
# Directory for uploaded files (images/videos)
UPLOAD_DIR="./uploads"
