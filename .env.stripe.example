# ============================================
# STRIPE CONFIGURATION (PHASE 4)
# ============================================

# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs (create in Dashboard > Products)
# Starter Pack: 100 credits for €9
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxxxxxxx

# Pro Pack: 500 credits for €39
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxx

# Power Pack: 1000 credits for €69
STRIPE_PRICE_POWER=price_xxxxxxxxxxxxxxxxxxxxx

# ============================================
# SETUP INSTRUCTIONS:
# ============================================
# 1. Go to: https://dashboard.stripe.com/test/products
# 2. Create 3 products:
#    - Name: "Starter Pack - 100 AI Credits"
#      Price: €9.00 (one-time payment)
#    - Name: "Pro Pack - 500 AI Credits"
#      Price: €39.00 (one-time payment)
#    - Name: "Power Pack - 1000 AI Credits"
#      Price: €69.00 (one-time payment)
# 3. Copy each Price ID (starts with price_) to the variables above
# 4. For production, use live keys (sk_live_xxx, pk_live_xxx)
# ============================================
