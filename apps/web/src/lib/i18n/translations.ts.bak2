export type TranslationKey =
  // Auth
  | 'auth.welcome_back'
  | 'auth.create_account'
  | 'auth.login_subtitle'
  | 'auth.signup_subtitle'
  | 'auth.name'
  | 'auth.name_placeholder'
  | 'auth.email'
  | 'auth.email_placeholder'
  | 'auth.password'
  | 'auth.password_placeholder'
  | 'auth.login_button'
  | 'auth.signup_button'
  | 'auth.or'
  | 'auth.demo_login'
  | 'auth.google_signin'
  | 'auth.no_account'
  | 'auth.have_account'
  | 'auth.signup_link'
  | 'auth.login_link'
  | 'auth.back_home'
  | 'auth.error.fields'
  | 'auth.error.login'
  | 'auth.error.signup'
  // Nav
  | 'nav.overview'
  | 'nav.generate'
  | 'nav.content'
  | 'nav.schedule'
  | 'nav.analytics'
  | 'nav.brand_kit'
  | 'nav.projects'
  | 'nav.logout'
  // Common
  | 'common.loading'
  | 'common.error'
  | 'common.success'
  | 'common.save'
  | 'common.cancel'
  | 'common.delete'
  | 'common.edit';

type Translations = Record<TranslationKey, string>;

