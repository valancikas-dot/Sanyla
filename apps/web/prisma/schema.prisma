generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ab_tests {
  id            String         @id
  name          String
  description   String?
  status        String         @default("RUNNING")
  winnerVariant String?
  projectId     String
  startDate     DateTime
  endDate       DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  ab_variants   ab_variants[]
  publications  publications[] @relation("ABTestToPublication")
}

model ab_variants {
  id            String   @id
  testId        String
  variant       String
  contentItemId String
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  engagement    Int      @default(0)
  conversions   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  ab_tests      ab_tests @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model ai_insights {
  id            String    @id
  projectId     String
  insightType   String
  title         String
  description   String
  priority      String?   @default("medium")
  actionItems   String[]
  data          Json?
  isRead        Boolean?  @default(false)
  isImplemented Boolean?  @default(false)
  createdAt     DateTime? @default(now()) @db.Timestamp(6)
  implementedAt DateTime? @db.Timestamp(6)
  projects      projects  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([priority], map: "idx_ai_insights_priority")
  @@index([projectId], map: "idx_ai_insights_project")
  @@index([isRead], map: "idx_ai_insights_read")
}

model assets {
  id        String   @id
  type      String
  filename  String
  path      String
  mimeType  String?
  size      Int?
  projectId String
  createdAt DateTime @default(now())
  projects  projects @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model audit_logs {
  id        String   @id
  action    String
  metadata  Json?
  userId    String
  createdAt DateTime @default(now())
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model campaigns {
  id              String           @id
  name            String?
  prompt          String
  aiCost          Int              @default(0)
  status          String           @default("DRAFT")
  userId          String
  projectId       String
  batchId         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  content_batches content_batches? @relation(fields: [batchId], references: [id], onUpdate: NoAction)
  projects        projects         @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt])
  @@index([projectId])
  @@index([userId])
}

model chat_messages {
  id        String   @id
  role      String
  content   String
  metadata  Json?
  projectId String
  userId    String
  createdAt DateTime @default(now())
}

model competitor_analysis {
  id                String    @id
  projectId         String
  competitorName    String
  competitorUrl     String?
  platform          String
  platformAccountId String?
  analysisType      String
  data              Json
  insights          String[]
  recommendations   String[]
  analyzedAt        DateTime? @default(now()) @db.Timestamp(6)
  createdAt         DateTime? @default(now()) @db.Timestamp(6)
  projects          projects  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([analyzedAt], map: "idx_competitor_analysis_date")
  @@index([projectId], map: "idx_competitor_analysis_project")
}

model competitor_posts {
  id           String      @id
  competitorId String
  platform     String
  postUrl      String
  content      String?
  publishedAt  DateTime?
  engagement   Int?
  metadata     Json?
  createdAt    DateTime    @default(now())
  competitors  competitors @relation(fields: [competitorId], references: [id], onDelete: Cascade)
}

model competitor_social_profiles {
  id            String      @id
  competitorId  String
  platform      String
  profileUrl    String
  profileHandle String?
  lastScrapedAt DateTime?
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  competitors   competitors @relation(fields: [competitorId], references: [id], onDelete: Cascade)
}

model competitors {
  id                         String                       @id
  name                       String
  website                    String?
  projectId                  String
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime
  competitor_posts           competitor_posts[]
  competitor_social_profiles competitor_social_profiles[]
}

model content_analytics {
  id               String           @id
  contentId        String
  platform         String
  postId           String?
  impressions      Int?             @default(0)
  reach            Int?             @default(0)
  engagement       Int?             @default(0)
  likes            Int?             @default(0)
  comments         Int?             @default(0)
  shares           Int?             @default(0)
  saves            Int?             @default(0)
  clicks           Int?             @default(0)
  videoViews       Int?             @default(0)
  engagementRate   Decimal?         @db.Decimal(5, 2)
  dataFetchedAt    DateTime?        @db.Timestamp(6)
  createdAt        DateTime?        @default(now()) @db.Timestamp(6)
  updatedAt        DateTime?        @default(now()) @db.Timestamp(6)
  content_calendar content_calendar @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([contentId], map: "idx_content_analytics_content")
}

model content_batches {
  id            String          @id
  name          String
  description   String?
  projectId     String
  createdAt     DateTime        @default(now())
  campaigns     campaigns[]
  projects      projects        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content_items content_items[]
}

model content_calendar {
  id                String              @id
  projectId         String
  scheduledDate     DateTime            @db.Date
  contentType       String
  platform          String
  status            String              @default("draft")
  caption           String?
  hashtags          String[]
  mediaUrls         String[]
  mediaType         String?
  targetAudience    String?
  postingTime       DateTime?           @db.Time(6)
  aiGenerated       Boolean?            @default(true)
  approvalNotes     String?
  performanceScore  Decimal?            @db.Decimal(3, 2)
  createdAt         DateTime?           @default(now()) @db.Timestamp(6)
  updatedAt         DateTime?           @default(now()) @db.Timestamp(6)
  postedAt          DateTime?           @db.Timestamp(6)
  approvedAt        DateTime?           @db.Timestamp(6)
  approvedBy        String?
  content_analytics content_analytics[]
  users             users?              @relation(fields: [approvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projects          projects            @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([scheduledDate], map: "idx_content_calendar_date")
  @@index([projectId], map: "idx_content_calendar_project")
  @@index([status], map: "idx_content_calendar_status")
}

model content_items {
  id              String           @id
  type            String
  title           String?
  content         Json
  metadata        Json?
  projectId       String
  batchId         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  content_batches content_batches? @relation(fields: [batchId], references: [id])
  projects        projects         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  publications    publications[]
  schedule_jobs   schedule_jobs[]
}

model credit_logs {
  id        String   @id
  action    String
  cost      Int
  userId    String
  metadata  Json?
  createdAt DateTime @default(now())
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([action])
  @@index([createdAt])
  @@index([userId])
}

model email_campaign_stats {
  id              String          @id
  campaignId      String          @unique
  sent            Int             @default(0)
  delivered       Int             @default(0)
  opened          Int             @default(0)
  clicked         Int             @default(0)
  bounced         Int             @default(0)
  unsubscribed    Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  email_campaigns email_campaigns @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model email_campaigns {
  id                   String                @id
  name                 String
  subject              String
  content              String
  status               String                @default("DRAFT")
  scheduledFor         DateTime?
  sentAt               DateTime?
  projectId            String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  email_campaign_stats email_campaign_stats?
  email_subscribers    email_subscribers[]   @relation("EmailCampaignToEmailSubscriber")
}

model email_subscribers {
  id              String            @id
  email           String
  name            String?
  status          String            @default("ACTIVE")
  tags            String[]
  metadata        Json?
  projectId       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  email_campaigns email_campaigns[] @relation("EmailCampaignToEmailSubscriber")

  @@unique([email, projectId])
}

model generated_media {
  id        String   @id
  type      String
  provider  String
  prompt    String
  url       String
  metadata  Json?
  projectId String
  createdAt DateTime @default(now())
}

model hashtag_performance {
  id          String   @id
  hashtagId   String
  postId      String?
  impressions Int      @default(0)
  engagement  Int      @default(0)
  date        DateTime
  createdAt   DateTime @default(now())
  hashtags    hashtags @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
}

model hashtags {
  id                  String                @id
  tag                 String
  platform            String
  popularity          Int?
  trending            Boolean               @default(false)
  projectId           String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  hashtag_performance hashtag_performance[]

  @@unique([tag, platform, projectId])
}

model integrations {
  id          String    @id
  type        String
  credentials String?
  config      Json?
  status      String    @default("ACTIVE")
  lastSyncAt  DateTime?
  projectId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  projects    projects  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model leads {
  id        String   @id
  email     String
  name      String?
  phone     String?
  company   String?
  source    String?
  status    String   @default("NEW")
  metadata  Json?
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model memberships {
  id             String        @id
  role           String        @default("owner")
  userId         String
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  organizations  organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          users         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model organizations {
  id               String             @id
  name             String
  slug             String             @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  memberships      memberships[]
  projects         projects[]
  subscriptions    subscriptions?
  team_invitations team_invitations[]
}

model payments {
  id                    String           @id
  subscriptionId        String
  amount                Int
  currency              String           @default("EUR")
  status                String
  stripePaymentIntentId String?
  stripeInvoiceId       String?
  plan                  SubscriptionPlan
  billingPeriod         String
  paidAt                DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime
  subscriptions         subscriptions    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model projects {
  id                  String                @id
  name                String
  industry            String?
  country             String?
  city                String?
  website             String?
  offer               String?
  prices              String?
  targetAudience      String?
  language            String                @default("en")
  tone                String                @default("professional")
  brandColors         String[]
  competitors         String?
  organizationId      String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  ai_insights         ai_insights[]
  assets              assets[]
  campaigns           campaigns[]
  competitor_analysis competitor_analysis[]
  content_batches     content_batches[]
  content_calendar    content_calendar[]
  content_items       content_items[]
  integrations        integrations[]
  organizations       organizations         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedule_jobs       schedule_jobs[]
  social_accounts     social_accounts[]
}

model publications {
  id              String          @id
  contentItemId   String
  socialAccountId String
  platform        String
  platformPostId  String?
  status          String          @default("SCHEDULED")
  publishedAt     DateTime?
  scheduledFor    DateTime
  error           String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  content_items   content_items   @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  social_accounts social_accounts @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  ab_tests        ab_tests[]      @relation("ABTestToPublication")
}

model schedule_jobs {
  id              String           @id
  scheduledFor    DateTime
  platform        String
  status          String           @default("DRAFT")
  payload         Json?
  error           String?
  contentItemId   String
  projectId       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  socialAccountId String?
  publishedAt     DateTime?
  platformPostId  String?
  content_items   content_items    @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  projects        projects         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  social_accounts social_accounts? @relation(fields: [socialAccountId], references: [id], onUpdate: NoAction, map: "schedule_jobs_socialaccountid_fkey")
  social_metrics  social_metrics[]

  @@index([socialAccountId], map: "schedule_jobs_socialaccountid_idx")
}

model social_accounts {
  id               String             @id
  platform         String
  accountId        String
  accountName      String
  accessToken      String
  refreshToken     String?
  tokenExpiry      DateTime?
  status           String             @default("ACTIVE")
  metadata         Json?
  projectId        String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  publications     publications[]
  schedule_jobs    schedule_jobs[]
  projects         projects           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  social_analytics social_analytics[]

  @@unique([platform, accountId, projectId])
  @@index([platform], map: "idx_social_accounts_platform")
  @@index([projectId], map: "idx_social_accounts_project")
}

model social_analytics {
  id              String          @id
  socialAccountId String
  publicationId   String?
  date            DateTime
  metric          String
  value           Int
  metadata        Json?
  createdAt       DateTime        @default(now())
  social_accounts social_accounts @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([socialAccountId, date])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model social_metrics {
  id             String        @id
  scheduleJobId  String
  impressions    Int?
  likes          Int?
  comments       Int?
  saves          Int?
  shares         Int?
  engagementRate Float?
  collectedAt    DateTime      @default(now())
  schedule_jobs  schedule_jobs @relation(fields: [scheduleJobId], references: [id], onDelete: Cascade)

  @@index([collectedAt])
  @@index([scheduleJobId])
}

model subscriptions {
  id                   String             @id
  organizationId       String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  maxProjects          Int                @default(1)
  maxAIImages          Int                @default(5)
  maxAIVideos          Int                @default(0)
  maxSocialAccounts    Int                @default(1)
  maxTeamMembers       Int                @default(1)
  usedAIImages         Int                @default(0)
  usedAIVideos         Int                @default(0)
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime
  payments             payments[]
  organizations        organizations      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model team_invitations {
  id             String        @id
  email          String
  role           String        @default("member")
  token          String        @unique
  status         String        @default("pending")
  organizationId String
  invitedBy      String?
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  organizations  organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([email, organizationId])
}

model usage_logs {
  id             String   @id
  organizationId String
  resourceType   String
  action         String
  quantity       Int      @default(1)
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, resourceType])
}

model users {
  id               String             @id
  email            String             @unique
  password         String?
  name             String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  role             String             @default("user")
  image            String?
  aiCredits        Int                @default(100)
  creditsPlan      String             @default("free")
  audit_logs       audit_logs[]
  campaigns        campaigns[]
  content_calendar content_calendar[]
  credit_logs      credit_logs[]
  memberships      memberships[]
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  PAUSED
}
