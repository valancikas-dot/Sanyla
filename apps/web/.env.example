# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/sanyla

# NextAuth
NEXTAUTH_SECRET=your-super-secret-key-here-change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (for Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OpenAI API (for AI content generation)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Facebook/Instagram OAuth (for social media posting)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# LinkedIn OAuth (for LinkedIn posting)
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Cron Job Security (for automated posting)
CRON_SECRET=your-very-secure-random-string-for-cron-authentication

# Optional: Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
